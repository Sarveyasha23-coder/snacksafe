# PostgreSQL via Neon
# Runtime connection: use the pooled Neon connection string (hostname includes -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/snacksafe?sslmode=require&schema=public"
# Direct connection: used by Prisma CLI migrations; use the non-pooled Neon hostname.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/snacksafe?sslmode=require&schema=public"

# Upstash Redis REST credentials (required for distributed production rate limiting)
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Optional: used by deployment platforms and observability integrations
NODE_ENV="development"
