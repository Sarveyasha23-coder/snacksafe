{
  "name": "snacksafe",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc --target ES2020 --module commonjs --moduleResolution node --outDir .test-build --rootDir . --skipLibCheck --strict lib/barcodes.ts lib/scoring.ts lib/products.ts lib/comparison.ts && node --test tests/*.test.cjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "@prisma/client": "^6.5.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "prisma": "^7.10.1"
  }
}
